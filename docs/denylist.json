{
  "schema_version": "1.0",
  "name": "dagashi_business_plan_denylist",
  "description": "L3無人実行から除外し、人間キューへ昇格する条件を定義する。",
  "default_action": "human_queue",
  "applies_to": {
    "level": "L3",
    "rule": "L判定時にこのJSONを確認し、matchesがtrueの項目がある場合はL3を禁止する。"
  },
  "match_policy": {
    "case_sensitive": false,
    "match_any_category": true,
    "on_uncertain_match": "human_queue"
  },
  "categories": [
